{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "Enchanted_Games"
  ],
  "contact": {
    "sources": "${source_url}",
    "issues": "${issue_tracker}"
  },
  "license": "${license}",
  "icon": "${icon}",
  "environment": "client",
  "entrypoints": {
    "main": [
      "games.enchanted.eg_stop_unloading_my_shaders.fabric.FabricCommonEntry"
    ],
    "client": [
      "games.enchanted.eg_stop_unloading_my_shaders.fabric.FabricClientEntry"
    ],
    "modmenu": [
      "games.enchanted.eg_stop_unloading_my_shaders.fabric.ModMenuIntegration"
    ]
  },
  "accessWidener": "eg_stop_unloading_my_shaders.accesswidener",
